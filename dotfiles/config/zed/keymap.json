// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-shift-c": "editor::CopyFileLocation",
            "shift-alt-up": "editor::MoveLineUp",
            "shift-alt-down": "editor::MoveLineDown",
        },
    },
    {
        "context": "vim_mode == normal || vim_mode == visual || vim_mode == operator",
        "bindings": {
            "alt-j": "editor::MoveLineDown",
            "alt-k": "editor::MoveLineUp",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "shift-escape": "workspace::ToggleAllDocks"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "alt-cmd-y": "workspace::ToggleAllDocks"
        }
    },
    {
        "bindings": {
            "cmd-5": "debug_panel::Toggle"
        }
    },
    {
        "context": "GitPanel",
        "bindings": {
            "ctrl-1": "git_panel::ActivateChangesTab"
        }
    },
    {
        "context": "GitPanel",
        "unbind": {
            "cmd-1": "git_panel::ActivateChangesTab"
        }
    },
    {
        "context": "GitPicker",
        "bindings": {
            "ctrl-1": "git_picker::ActivateBranchesTab"
        }
    },
    {
        "context": "GitPicker",
        "unbind": {
            "cmd-1": "git_picker::ActivateBranchesTab"
        }
    },
    {
        "context": "RunModal",
        "bindings": {
            "ctrl-1": "new_process_modal::ActivateTaskTab"
        }
    },
    {
        "context": "RunModal",
        "unbind": {
            "cmd-1": "new_process_modal::ActivateTaskTab"
        }
    },
    {
        "context": "Welcome",
        "bindings": {
            "ctrl-1": [
                "welcome::OpenRecentProject",
                0
            ]
        }
    },
    {
        "context": "Welcome",
        "unbind": {
            "cmd-1": [
                "welcome::OpenRecentProject",
                0
            ]
        }
    },
    {
        "context": "GitPanel",
        "bindings": {
            "ctrl-2": "git_panel::ActivateHistoryTab"
        }
    },
    {
        "context": "GitPanel",
        "unbind": {
            "cmd-2": "git_panel::ActivateHistoryTab"
        }
    },
    {
        "context": "GitPicker",
        "bindings": {
            "ctrl-2": "git_picker::ActivateStashTab"
        }
    },
    {
        "context": "GitPicker",
        "unbind": {
            "cmd-2": "git_picker::ActivateStashTab"
        }
    },
    {
        "context": "RunModal",
        "bindings": {
            "ctrl-2": "new_process_modal::ActivateDebugTab"
        }
    },
    {
        "context": "RunModal",
        "unbind": {
            "cmd-2": "new_process_modal::ActivateDebugTab"
        }
    },
    {
        "context": "Welcome",
        "bindings": {
            "ctrl-2": [
                "welcome::OpenRecentProject",
                1
            ]
        }
    },
    {
        "context": "Welcome",
        "unbind": {
            "cmd-2": [
                "welcome::OpenRecentProject",
                1
            ]
        }
    }
]
